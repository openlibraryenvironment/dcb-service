# DCB setup profile -- copy, do not edit in place:
#
#     cp scripts/profiles/example.env.template scripts/profiles/local.env
#     ./scripts/dcb_setup.sh --profile local --bundle example
#
# scripts/profiles/*.env is gitignored. This .template file is the only one
# committed, so never put a real secret in it.
#
# Anything a bundle references as ${VAR} must be set here. dcb_setup.sh fails
# up front listing any that are missing, rather than POSTing empty values.

# --- Target environment ------------------------------------------------------

DCB_TARGET="http://localhost:8080"

# --- Keycloak ----------------------------------------------------------------
# KEYCLOAK_BASE is the realm URL; dcb_setup.sh appends
# /protocol/openid-connect/token.

KEYCLOAK_BASE="https://auth.example.org/realms/example"
KEYCLOAK_CLIENT="dcb"
KEYCLOAK_SECRET="change-me"
DCB_ADMIN_USER="testadmin"
DCB_ADMIN_PASS="change-me"

# Shown in the DCB audit trail for uploaded locations and mappings.
UPLOAD_REASON="local setup"

# --- Bundle variables --------------------------------------------------------
# The `example` bundle references the following. Add your own as you add config;
# the names are yours to choose, they just have to match the bundle files.

# FOLIO
EXAMPLE_FOLIO_BASE_URL="https://edge.folio.example.org/"
EXAMPLE_FOLIO_USER_BASE_URL="https://folio.example.org/"
EXAMPLE_FOLIO_APIKEY="change-me"

# Sierra
EXAMPLE_SIERRA_BASE_URL="https://sierra.example.org"
EXAMPLE_SIERRA_KEY="change-me"
EXAMPLE_SIERRA_SECRET="change-me"

# Foundation / Evergreen (profiles A+B: NCIP primitives + a vendor-API override).
#
# FoundationClient composes a base protocol adaptor with per-operation
# overrides. Only two override keys exist: "renew" (CirculationStrategy) and
# "patron" (PatronStrategy).
EXAMPLE_EVERGREEN_NCIP_ENDPOINT_URL="https://evergreen.example.org/ncip"
EXAMPLE_EVERGREEN_NCIP_FROM_AGENCY="DCB-CENTRAL"
EXAMPLE_EVERGREEN_NCIP_TO_AGENCY="EXAMPLE_EVERGREEN"

# Read from the TOP LEVEL of clientConfig by EvergreenExampleCustomOverride,
# which appends /osrf-gateway-v1 to it.
EXAMPLE_EVERGREEN_API_URL="https://evergreen.example.org"

# ORS Appliance (profile D: declarative NCIP v2.02, event-driven tracking).
#
# NCIP_SYSTEM_ID / NCIP_AGENCY_ID are the *appliance's* NCIP identity, not
# DCB's. DCB's own identity is instance-wide application config, not a profile
# variable:  dcb.ncip.system-id / dcb.ncip.agency-id
# (env: DCB_NCIP_SYSTEM_ID / DCB_NCIP_AGENCY_ID).
EXAMPLE_ORS_NCIP_ENDPOINT_URL="https://appliance.example.org/ncip/v2_02"
EXAMPLE_ORS_NCIP_SYSTEM_ID="EXAMPLE-APPLIANCE"
EXAMPLE_ORS_NCIP_AGENCY_ID="EXAMPLE-APPLIANCE"

# INSECURE (the default) or JWT_REQUIRED. Under JWT_REQUIRED the host also needs
# ncip-peer-issuer, ncip-peer-jwks-url and ncip-peer-audience -- see
# docs/unified-host-interaction-integration-guide.md section 4.2.
EXAMPLE_ORS_PEER_AUTH_MODE="INSECURE"

# OAI-PMH ingest. Supply tenant-id and DCB derives
# /ors-appliance/api/V1/public/<tenant-id>/oai, or set oai-endpoint-url in the
# bundle to override the path outright.
EXAMPLE_ORS_BASE_URL="https://appliance.example.org"
EXAMPLE_ORS_TENANT_ID="example-tenant"
